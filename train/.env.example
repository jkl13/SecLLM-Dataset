# Environment variables used by the training code under train/.
#
#   cp train/.env.example train/.env    # then fill in the values
#
# train/sft/train_sft.py and train/sft/select/judge_select.py read the first .env found
# walking up from their own directory, so train/.env is found from any working directory.
# Variables already exported in the shell take precedence over this file.
# The other scripts do not read .env; export the variables first if they need them:
#   set -a; . train/.env; set +a

# ---- Weights & Biases: train_sft.py logs every run to W&B -------------------------
# Required unless WANDB_MODE is set to offline or disabled.
WANDB_API_KEY=
# Optional. Project the runs are logged to (default: qwen35-secfix-sft).
# WANDB_PROJECT=qwen35-secfix-sft
# Optional. Team or user that owns the project (default: the API key's default entity).
# WANDB_ENTITY=
# Optional. "offline" logs locally without an API key (upload later with `wandb sync`);
# "disabled" turns logging off.
# WANDB_MODE=offline

# ---- Hugging Face Hub: Qwen/Qwen3.5-9B model and tokenizer downloads ---------------
# Optional. The model is public; a token only raises the download rate limits.
# HF_TOKEN=

# ---- Judge server: selection stage 2 (judge_select.py) -----------------------------
# Required for stage 2 only. OpenAI-compatible base URL ending in /v1, for example
# http://localhost:8000/v1 for a vLLM server on the same machine.
JUDGE_API_URL=
# Required for stage 2 only. Model name exactly as the judge server serves it.
JUDGE_MODEL=
# Optional. Bearer token for the judge server (default: EMPTY, which a local vLLM
# server accepts).
# JUDGE_API_KEY=
